{
  "name": "relay",
  "version": "0.2.0",
  "description": "A durable terminal coding workspace",
  "bin": {
    "relay": "./cli.ts"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "build": "bun build cli.ts --target bun --outdir dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@google/genai": "^2.8.0",
    "@types/bun": "^1.3.14",
    "@types/commander": "^2.12.5",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
